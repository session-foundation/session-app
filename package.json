{
  "name": "session-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo build",
    "codegen": "turbo codegen",
    "codegen:check": "turbo codegen:check",
    "dev": "turbo dev",
    "dev:fake": "turbo dev:fake",
    "dev:desktop": "pnpm --filter @session/desktop dev",
    "dev:desktop:fake": "pnpm --filter @session/desktop dev:fake",
    "dev:mobile": "pnpm --filter @session/mobile dev",
    "dev:mobile:fake": "pnpm --filter @session/mobile dev:fake",
    "fake-media:fetch": "node --disable-warning=ExperimentalWarning packages/client/scripts/fetchFakeMedia.ts",
    "android": "pnpm --filter @session/mobile android",
    "ios": "pnpm --filter @session/mobile ios",
    "lint": "turbo lint",
    "boundaries": "depcruise --config tooling/depcruise-config/root.cjs $(ls -d packages apps tests tooling 2>/dev/null)",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:native": "pnpm --filter @session/bridge-rn run --if-present test:native",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:manifests": "eslint --no-config-lookup --config eslint.config.js \"**/package.json\" pnpm-workspace.yaml && pnpm --filter @session/turbo-guard check"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
