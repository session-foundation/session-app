{
  "name": "@session/client-contract",
  "version": "0.0.0",
  "private": true,
  "description": "The behavioural suite every SessionClient must satisfy, fake and real alike",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "media-vectors:hpp": "node --disable-warning=ExperimentalWarning scripts/writeMediaVectors.ts"
  },
  "dependencies": {
    "@session/client": "workspace:*"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jpeg-js": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
