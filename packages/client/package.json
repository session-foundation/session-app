{
  "name": "@session/client",
  "version": "0.0.0",
  "private": true,
  "description": "The SessionClient facade over the libsession bridge, and the fake that stands in for it",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@session/basic-types": "workspace:*",
    "@session/bridge-types": "workspace:*"
  },
  "peerDependencies": {
    "@session/bridge-rn": "workspace:*"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
