{
  "name": "@session/bridge-rn",
  "version": "0.0.0",
  "private": true,
  "description": "The Nitro module: the C++ shim, loaded in the mobile app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "nitrogen",
    "codegen:check": "nitrogen && git diff --exit-code -- nitrogen/generated",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:native": "bash tests/cpp/run.sh",
    "build:libsession:android": "./scripts/build-libsession-android.sh",
    "build:libsession:ios": "./scripts/build-libsession-ios.sh"
  },
  "dependencies": {
    "@session/bridge-types": "workspace:*",
    "react-native-nitro-modules": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "nitrogen": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "codegenConfig": {
    "name": "SessionBridgeRNSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "session.bridge.rn"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTImageURLLoader": [
          "SessionMediaImageLoader"
        ]
      }
    }
  }
}
