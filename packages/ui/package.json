{
  "name": "@session/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Every visual component, and the tamagui configuration both apps share",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./brandMark": "./src/brandMark.ts",
    "./themes": "./src/themes.ts",
    "./catalog": "./src/catalog/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@session/basic-types": "workspace:*",
    "@session/test-ids": "workspace:*",
    "@session/theme-tokens": "workspace:*",
    "@tamagui/lucide-icons-2": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "tamagui": "catalog:",
    "uqr": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/expectations": "workspace:*",
    "@session/render-tier": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-web": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
