{
  "name": "@session/bridge-node",
  "version": "0.0.0",
  "private": true,
  "description": "The N-API addon: the C++ shim, loaded in the Electron main process",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./addon": "./build/Release/session_bridge_node.node"
  },
  "scripts": {
    "build:native": "node ../../scripts/patch-libsession.mjs && cmake-js configure --CDCMAKE_C_COMPILER=\"${SESSION_BRIDGE_CC:-gcc}\" --CDCMAKE_CXX_COMPILER=\"${SESSION_BRIDGE_CXX:-g++}\" --CDUSE_LTO=OFF --CDWITH_TESTS=OFF --CDSUBMODULE_CHECK=OFF --CDSESSION_BRIDGE_TESTING=OFF && cmake-js build --parallel",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:native:testing": "node ../../scripts/patch-libsession.mjs && cmake-js configure --CDCMAKE_C_COMPILER=\"${SESSION_BRIDGE_CC:-gcc}\" --CDCMAKE_CXX_COMPILER=\"${SESSION_BRIDGE_CXX:-g++}\" --CDUSE_LTO=OFF --CDWITH_TESTS=OFF --CDSUBMODULE_CHECK=OFF --CDSESSION_BRIDGE_TESTING=ON && cmake-js build --parallel"
  },
  "dependencies": {
    "@session/bridge-types": "workspace:*",
    "@session/client": "workspace:*",
    "node-addon-api": "catalog:",
    "@session/proto": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@session/client-contract": "workspace:*",
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "cmake-js": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@session/bench": "workspace:*"
  }
}
