{
  "name": "@session/bridge-node",
  "version": "0.0.0",
  "private": true,
  "description": "The N-API addon: the C++ shim, loaded in the Electron main process",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./addon": "./build/Release/session_bridge_node.node"
  },
  "scripts": {
    "build:native": "./scripts/build-libsession.sh && cmake-js configure --CDSESSION_BRIDGE_LIBSESSION_BUNDLE=\"$PWD/build-libsession/libsession-util.a\" --CDCMAKE_C_COMPILER=\"${SESSION_BRIDGE_CC:-gcc}\" --CDCMAKE_CXX_COMPILER=\"${SESSION_BRIDGE_CXX:-g++}\" --CDSESSION_BRIDGE_TESTING=OFF && cmake-js build --parallel",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "build:native:testing": "./scripts/build-libsession.sh && cmake-js configure --CDSESSION_BRIDGE_LIBSESSION_BUNDLE=\"$PWD/build-libsession/libsession-util.a\" --CDCMAKE_C_COMPILER=\"${SESSION_BRIDGE_CC:-gcc}\" --CDCMAKE_CXX_COMPILER=\"${SESSION_BRIDGE_CXX:-g++}\" --CDSESSION_BRIDGE_TESTING=ON && cmake-js build --parallel"
  },
  "dependencies": {
    "@session/bridge-types": "workspace:*",
    "@session/client": "workspace:*",
    "node-addon-api": "catalog:"
  },
  "devDependencies": {
    "@session/client-contract": "workspace:*",
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "cmake-js": "catalog:",
    "eslint": "catalog:",
    "jpeg-js": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@session/bench": "workspace:*"
  }
}
