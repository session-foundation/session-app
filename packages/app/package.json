{
  "name": "@session/app",
  "version": "0.0.0",
  "private": true,
  "description": "Platform ports, the navigation seam and the route registry both apps share",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./exportFileName": "./src/exportFileName.ts",
    "./mediaUrl": "./src/mediaUrl.ts",
    "./flags": "./src/flags.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "codegen": "node --disable-warning=ExperimentalWarning scripts/generateUrls.ts",
    "codegen:check": "node --disable-warning=ExperimentalWarning scripts/generateUrls.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@session/client-contract": "workspace:*",
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@session/basic-types": "workspace:*",
    "@session/client": "workspace:*",
    "@session/logging": "workspace:*"
  }
}
