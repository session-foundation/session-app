{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "codegen": {
      "inputs": [
        "proto/**",
        "src/**/*.nitro.ts",
        "buf.gen.yaml",
        "../../packages/bridge-types/src/**"
      ],
      "outputs": ["src/gen/**", "nitrogen/generated/**"]
    },
    "codegen:check": {
      "dependsOn": ["codegen"],
      "cache": false
    },
    "@session/app#codegen": {
      "inputs": [
        "scripts/**",
        "../../libsession-util/include/session/session_protocol.h",
        "../../libsession-util/src/session_protocol.cpp",
        "src/urls.generated.ts"
      ],
      "outputs": ["src/urls.generated.ts"],
      "cache": false
    },
    "@session/mobile#codegen": {
      "inputs": [
        "scripts/generatePushWords.ts",
        "src/pushWords.ts",
        "../../packages/localization/src/notificationWordSources.ts",
        "../../packages/localization/src/localization-src/generated/**"
      ],
      "outputs": [
        "modules/session-push/android/src/main/java/org/getsession/push/PushWords.generated.kt",
        "modules/session-push/ios/PushWords.generated.swift",
        "notification-service/PushWords.generated.h"
      ],
      "cache": false
    },
    "@session/bridge-codegen#codegen": {
      "inputs": ["src/**", "../../packages/bridge-types/src/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:native": {
      "inputs": [
        "src/**",
        "scripts/**",
        "CMakeLists.txt",
        "../bridge-core/**",
        "../../libsession-util/**"
      ],
      "outputs": ["prebuilds/**", "build/Release/**"],
      "env": ["SESSION_BRIDGE_CC", "SESSION_BRIDGE_CXX", "MACOSX_DEPLOYMENT_TARGET"],
      "passThroughEnv": [
        "SESSION_LIBSESSION_CACHE",
        "SESSION_LIBSESSION_CACHE_MAX_GB",
        "SESSION_LIBSESSION_SUBMODULE_CHECK",
        "SESSION_BRIDGE_DEPS_MIRROR"
      ]
    },
    "dev": {
      "dependsOn": ["^codegen"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_SESSION_*", "SESSION_*"]
    },
    "dev:fake": {
      "dependsOn": ["^codegen"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_SESSION_*", "SESSION_*"]
    },
    "typecheck": {
      "dependsOn": ["^codegen", "^build"]
    },
    "lint": {
      "dependsOn": ["^build", "^codegen"]
    },
    "test": {
      "dependsOn": ["^codegen", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e:fast": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:full": {
      "dependsOn": ["^build", "^build:native"],
      "cache": false
    }
  }
}
