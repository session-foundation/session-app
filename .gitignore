node_modules/
dist/
out/
build/
coverage/
.turbo/
*.log

# Expo prebuild output - generated, never committed.
#
# Listed per app rather than globbed: `**/android/` and `**/ios/` would also swallow
# packages/bridge-rn/android and .../ios, which are real tracked sources - CMakeLists.txt,
# OnLoad.cpp, the Kotlin package, the podspec's README. So a new Expo app needs four lines here.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.gitignore
apps/mobile/.tamagui/
apps/mobile/expo-env.d.ts
tests/bench/mobile/android/
tests/bench/mobile/ios/
tests/bench/mobile/.tamagui/
tests/bench/mobile/expo-env.d.ts

# `expo start` writes this, and it is per-machine: a device list and Expo's own README about
# why not to commit it. Matched anywhere rather than per-app, because there are two Expo
# project, and the next one should not have to remember to add a line here.
**/.expo/

# Native build artifacts
prebuilds/
packages/*/build/
packages/proto/gen-cpp/
libsession-util/build-ios/
packages/bridge-rn/ios/*.xcframework/
packages/bridge-rn/ios/lib/
packages/bridge-core/build-ios/
.cxx/
libsession-util/build-android/

# Playwright
test-results/
playwright-report/
blob-report/

# Local env
.env
.env.local

.DS_Store
.vscode/

# Local review worktrees
.claude/worktrees/

# Built by esbuild for the on-device browser benchmark; reproducible from the src entries.
tests/bench/mobile/web/bench.js
tests/bench/mobile/web/render.js
