{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/localization": {
      "project": ["src/**/*.ts", "!src/localization-src/**"]
    },
    "tests/bench/mobile": {
      "entry": [
        "src/web-entry.ts",
        "src/web-render-entry.tsx",
        "src/nitro-stub.ts",
        "collector.mjs",
        "web/serve.mjs"
      ],
      "project": ["**/*.{ts,tsx,mjs,js}", "!android/**", "!ios/**", "!web/*.js"]
    }
  },
  "ignoreDependencies": [
    "expo-updates",
    "expo-system-ui",
    "@bufbuild/protoc-gen-es",
    "dependency-cruiser",
    "@session/eslint-config",
    "@session/typescript-config",
    "eslint-import-resolver-typescript",
    "react-native-web",
    "node-addon-api",
    "@session/bridge-rn",
    "react-native-nitro-modules",
    "react-native-safe-area-context"
  ],
  "ignoreBinaries": ["brew"],
  "ignore": ["**/*.native.ts", "**/*.native.tsx", "libsession-util/**"]
}
